{
  "type": "page",
  "title": "邮件配置",
  "body": {
    "type": "form",
    "api": "put:/api/v1/config/email",
    "mode": "horizontal",
    "body": [
      { "type": "input-text", "name": "smtp_host", "label": "SMTP 服务器" },
      { "type": "input-number", "name": "smtp_port", "label": "SMTP 端口", "value": 465 },
      { "type": "input-text", "name": "smtp_user", "label": "发件人邮箱" },
      { "type": "input-password", "name": "smtp_password", "label": "邮箱密码/授权码" },
      { "type": "input-text", "name": "from_email", "label": "发件人地址" },
      { "type": "input-text", "name": "from_name", "label": "发件人名称" },
      { "type": "switch", "name": "smtp_ssl", "label": "启用 SSL", "value": true }
    ],
    "actions": [{ "type": "submit", "label": "保存配置", "level": "primary" }]
  }
}
