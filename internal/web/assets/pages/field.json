{
  "type": "page",
  "title": "字段管理",
  "body": {
    "type": "crud",
    "name": "fieldCrud",
    "api": {
      "method": "get",
      "url": "/api/v1/fields/list"
    },
    "perPage": 10,
    "perPageAvailable": [10, 20, 50, 100],
    "pageField": "page",
    "perPageField": "page_size",
    "columns": [
      { "name": "id", "label": "ID", "width": 70 },
      { "name": "project_id", "label": "所属项目", "width": 90 },
      { "name": "name", "label": "字段名称" },
      { "name": "type_text", "label": "类型", "width": 80 },
      { "name": "parse_path", "label": "解析路径", "width": 180 },
      { "name": "default_value", "label": "默认值配置", "width": 220 },
      { "name": "status_text", "label": "状态", "width": 80 },
      { "name": "updated_user", "label": "最后编辑", "width": 100 },
      { "name": "updated_at_text", "label": "更新时间", "width": 170 },
      {
        "type": "operation",
        "label": "操作",
        "width": 150,
        "buttons": [
          {
            "type": "button",
            "label": "编辑",
            "actionType": "dialog",
            "dialog": {
              "title": "编辑字段",
              "size": "lg",
              "body": {
                "type": "form",
                "reload": "fieldCrud",
                "initApi": {
                  "method": "get",
                  "url": "/api/v1/fields/detail?id=${id}"
                },
                "api": {
                  "method": "post",
                  "url": "/api/v1/fields/update"
                },
                "body": [
                  {
                    "type": "select",
                    "name": "project_id",
                    "label": "所属项目",
                    "required": true,
                    "source": {
                      "method": "get",
                      "url": "/api/v1/projects/list?page=1&page_size=100",
                      "adaptor": "return {options:(payload.data.items||[]).map(function(it){return {label:it.name, value:String(it.id)}})};"
                    }
                  },
                  { "type": "input-text", "name": "name", "label": "字段名称", "required": true, "maxLength": 200 },
                  {
                    "type": "select",
                    "name": "type",
                    "label": "字段类型",
                    "required": true,
                    "options": "$frag:_frags/field-type-options.json"
                  },
                  {
                    "type": "input-text",
                    "name": "default_value",
                    "label": "默认值配置",
                    "required": true,
                    "placeholder": "如 {\"type\":\"int\",\"value\":0}，type 必须与字段类型一致",
                    "description": "JSON 格式：{\"type\":\"<与字段类型相同>\",\"value\":<默认值>}。整数只能填整数、浮点数填数字、字符串填\"\", 布尔填 true/false、数组填 []、对象填 {}"
                  },
                  { "type": "input-text", "name": "parse_path", "label": "解析路径", "required": true, "maxLength": 500, "placeholder": "同一项目下唯一，如 user.age" },
                  {
                    "type": "select",
                    "name": "status",
                    "label": "状态",
                    "required": true,
                    "options": "$frag:_frags/status-active-options.json"
                  },
                  { "type": "textarea", "name": "remark", "label": "备注", "maxLength": 2000 }
                ]
              }
            }
          },
          {
            "type": "button",
            "label": "删除",
            "level": "danger",
            "actionType": "dialog",
            "dialog": {
              "title": "删除确认",
              "body": {
                "type": "form",
                "reload": "fieldCrud",
                "api": {
                  "method": "post",
                  "url": "/api/v1/fields/delete",
                  "data": { "id": "${id}" }
                },
                "body": [
                  { "type": "alert", "body": "确认删除该字段？删除后不可恢复。", "level": "warning" }
                ]
              }
            }
          }
        ]
      }
    ],
    "filter": {
      "title": "筛选",
      "body": [
        { "type": "input-text", "name": "name", "label": "字段名称（模糊）" },
        {
          "type": "select",
          "name": "type",
          "label": "类型",
          "clearable": true,
          "options": "$frag:_frags/field-type-options.json"
        },
        {
          "type": "select",
          "name": "status",
          "label": "状态",
          "clearable": true,
          "options": "$frag:_frags/status-active-options.json"
        }
      ]
    },
    "headerToolbar": [
      "filter",
      "reload",
      {
        "type": "button",
        "label": "新增字段",
        "level": "primary",
        "actionType": "dialog",
        "dialog": {
          "title": "新增字段",
          "size": "lg",
          "body": {
            "type": "form",
            "reload": "fieldCrud",
            "api": {
              "method": "post",
              "url": "/api/v1/fields/add"
            },
            "body": [
              {
                "type": "select",
                "name": "project_id",
                "label": "所属项目",
                "required": true,
                "source": {
                  "method": "get",
                  "url": "/api/v1/projects/list?page=1&page_size=100",
                  "adaptor": "return {options:(payload.data.items||[]).map(function(it){return {label:it.name, value:String(it.id)}})};"
                }
              },
              { "type": "input-text", "name": "name", "label": "字段名称", "required": true, "maxLength": 200 },
              {
                "type": "select",
                "name": "type",
                "label": "字段类型",
                "required": true,
                "options": "$frag:_frags/field-type-options.json"
              },
              {
                "type": "input-text",
                "name": "default_value",
                "label": "默认值配置",
                "required": true,
                "placeholder": "如 {\"type\":\"int\",\"value\":0}，type 必须与字段类型一致",
                "description": "JSON 格式：{\"type\":\"<与字段类型相同>\",\"value\":<默认值>}。整数只能填整数、浮点数填数字、字符串填\"\", 布尔填 true/false、数组填 []、对象填 {}"
              },
              { "type": "input-text", "name": "parse_path", "label": "解析路径", "required": true, "maxLength": 500, "placeholder": "同一项目下唯一，如 user.age" },
              {
                "type": "select",
                "name": "status",
                "label": "状态",
                "placeholder": "请选择状态（默认生效）",
                "options": "$frag:_frags/status-active-options.json"
              },
              { "type": "textarea", "name": "remark", "label": "备注", "maxLength": 2000 }
            ]
          }
        }
      }
    ],
    "footerToolbar": [
      "switch-per-page",
      "pagination"
    ]
  }
}
