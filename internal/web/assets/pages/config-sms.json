{
  "type": "page",
  "title": "短信配置",
  "body": {
    "type": "form",
    "api": "put:/api/v1/config/sms",
    "mode": "horizontal",
    "body": [
      { "type": "select", "name": "provider", "label": "短信服务商", "options": [{ "label": "阿里云", "value": "aliyun" }, { "label": "腾讯云", "value": "qcloud" }, { "label": "华为云", "value": "huawei" }] },
      { "type": "input-text", "name": "access_key_id", "label": "AccessKey ID" },
      { "type": "input-password", "name": "access_key_secret", "label": "AccessKey Secret" },
      { "type": "input-text", "name": "sign_name", "label": "短信签名" },
      { "type": "input-text", "name": "template_code", "label": "模板 Code" }
    ],
    "actions": [{ "type": "submit", "label": "保存配置", "level": "primary" }]
  }
}
