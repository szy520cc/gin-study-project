{
  "type": "page",
  "title": "配置包管理",
  "body": {
    "type": "crud",
    "name": "configPackCrud",
    "api": {
      "method": "get",
      "url": "/api/v1/config-packs/list"
    },
    "perPage": 10,
    "perPageAvailable": [10, 20, 50, 100],
    "pageField": "page",
    "perPageField": "page_size",
    "columns": [
      { "name": "id", "label": "ID", "width": 70 },
      { "name": "project_name", "label": "项目名称", "width": 140 },
      { "name": "name", "label": "配置包名称" },
      { "name": "logo", "label": "配置包标识", "width": 150 },
      {
        "type": "tpl",
        "name": "status",
        "label": "状态",
        "width": 90,
        "tpl": "<span class='label label-${status == 1 ? \"success\" : \"danger\"}'>${status == 1 ? '生效' : '废弃'}</span>"
      },
      { "name": "updated_user", "label": "最后编辑", "width": 100 },
      { "name": "updated_at_text", "label": "更新时间", "width": 170 },
      {
        "type": "operation",
        "label": "操作",
        "width": 150,
        "buttons": [
          {
            "type": "button",
            "label": "编辑",
            "actionType": "dialog",
            "dialog": {
              "title": "编辑配置包",
              "size": "md",
              "body": {
                "type": "form",
                "reload": "configPackCrud",
                "initApi": {
                  "method": "get",
                  "url": "/api/v1/config-packs/detail?id=${id}"
                },
                "api": {
                  "method": "post",
                  "url": "/api/v1/config-packs/update"
                },
                "body": [
                  {
                    "type": "select",
                    "name": "project_id",
                    "label": "所属项目",
                    "required": true,
                    "disabled": true,
                    "source": {
                      "method": "get",
                      "url": "/api/v1/projects/list?page=1&page_size=100",
                      "adaptor": "return {options:(payload.data.items||[]).map(function(it){return {label:it.name, value:String(it.id)}})};"
                    }
                  },
                  { "type": "input-text", "name": "name", "label": "配置包名称", "required": true, "maxLength": 200 },
                  {
                    "type": "input-text",
                    "name": "logo",
                    "label": "配置包标识",
                    "disabled": true,
                    "description": "配置包标识创建后不允许修改"
                  },
                  {
                    "type": "select",
                    "name": "status",
                    "label": "状态",
                    "required": true,
                    "options": "$frag:_frags/status-active-options.json"
                  },
                  { "type": "textarea", "name": "remark", "label": "备注", "maxLength": 2000 }
                ]
              }
            }
          },
          {
            "type": "button",
            "label": "删除",
            "level": "danger",
            "actionType": "dialog",
            "dialog": {
              "title": "删除确认",
              "body": {
                "type": "form",
                "reload": "configPackCrud",
                "api": {
                  "method": "post",
                  "url": "/api/v1/config-packs/delete",
                  "data": { "id": "${id}" }
                },
                "body": [
                  { "type": "alert", "body": "确认删除该配置包？删除后不可恢复。", "level": "warning" }
                ]
              }
            }
          }
        ]
      }
    ],
    "filter": {
      "title": "筛选",
      "body": [
        { "type": "input-text", "name": "name", "label": "配置包名称（模糊）" },
        {
          "type": "select",
          "name": "status",
          "label": "状态",
          "clearable": true,
          "options": "$frag:_frags/status-active-options.json"
        },
        {
          "type": "select",
          "name": "project_id",
          "label": "所属项目",
          "clearable": true,
          "placeholder": "全部项目",
          "source": {
            "method": "get",
            "url": "/api/v1/projects/list?page=1&page_size=100",
            "adaptor": "return {options:(payload.data.items||[]).map(function(it){return {label:it.name, value:String(it.id)}})};"
          }
        }
      ]
    },
    "headerToolbar": [
      "filter",
      "reload",
      {
        "type": "button",
        "label": "新增配置包",
        "level": "primary",
        "actionType": "dialog",
        "dialog": {
          "title": "新增配置包",
          "size": "md",
          "body": {
            "type": "form",
            "reload": "configPackCrud",
            "api": {
              "method": "post",
              "url": "/api/v1/config-packs/add"
            },
            "body": [
              {
                "type": "select",
                "name": "project_id",
                "label": "所属项目",
                "required": true,
                "source": {
                  "method": "get",
                  "url": "/api/v1/projects/list?page=1&page_size=100",
                  "adaptor": "var m=window.__projLogoMap=window.__projLogoMap||{};(payload.data.items||[]).forEach(function(it){m[String(it.id)]=it.logo;});return {options:(payload.data.items||[]).map(function(it){return {label:it.name+'（'+it.logo+'）', value:String(it.id)}})};"
                },
                "onEvent": {
                  "change": {
                    "actions": [
                      {
                        "actionType": "custom",
                        "script": "(function(event){var m=window.__projLogoMap||{},pid=String(event.data&&event.data.project_id||''),lgo=m[pid];if(!lgo){return;}var pre=lgo+'.';var tail=String(event.data.logo_tail==null?'':event.data.logo_tail);var known=[],k;for(k in m){if(m[k]){known.push(m[k]+'.');}}for(var i=0;i<known.length;i++){if(tail.indexOf(known[i])===0){tail=tail.slice(known[i].length);break;}}tail=tail.replace(/^\\.+/,'');doAction({actionType:'setValue',componentId:'projPrefixAdd',ignoreError:true,args:{value:pre}});doAction({actionType:'setValue',componentId:'logoTailAdd',ignoreError:true,args:{value:tail}});doAction({actionType:'setValue',componentId:'logoFullAdd',ignoreError:true,args:{value:pre+tail}});})(event);"
                      }
                    ]
                  }
                }
              },
              { "type": "input-text", "name": "name", "label": "配置包名称", "required": true, "maxLength": 200 },
              {
                "type": "hidden",
                "name": "_proj_prefix",
                "id": "projPrefixAdd"
              },
              {
                "type": "input-text",
                "id": "logoTailAdd",
                "name": "logo_tail",
                "label": "配置包标识",
                "required": true,
                "maxLength": 200,
                "prefix": "${_proj_prefix}",
                "placeholder": "如 ec_risk_pack",
                "description": "已自动带入所选「项目标识」作为前缀（只读，不可修改），只需填写其后的标识；如 ecommerce.ec_risk_pack 只需填 ec_risk_pack。",
                "validations": { "matchRegexp": "^[a-z_][a-z0-9_]*$" },
                "validationErrors": { "matchRegexp": "标识只能由小写字母、数字、下划线组成，且不能以数字开头" },
                "onEvent": {
                  "change": {
                    "actions": [
                      {
                        "actionType": "custom",
                        "script": "(function(event){var pre=String(event.data._proj_prefix||'');var tail=String(event.data.logo_tail==null?'':event.data.logo_tail);doAction({actionType:'setValue',componentId:'logoFullAdd',ignoreError:true,args:{value:pre+tail}});})(event);"
                      }
                    ]
                  }
                }
              },
              {
                "type": "hidden",
                "name": "logo",
                "id": "logoFullAdd"
              },
              {
                "type": "select",
                "name": "status",
                "label": "状态",
                "placeholder": "请选择状态（默认生效）",
                "options": "$frag:_frags/status-active-options.json"
              },
              { "type": "textarea", "name": "remark", "label": "备注", "maxLength": 2000 }
            ]
          }
        }
      }
    ],
    "footerToolbar": [
      "switch-per-page",
      "pagination"
    ]
  }
}
