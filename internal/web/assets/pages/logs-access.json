{
  "type": "page",
  "title": "访问日志",
  "body": {
    "type": "crud",
    "api": { "method": "get", "url": "/api/v1/logs/access" },
    "perPage": 15,
    "columns": [
      { "name": "id", "label": "ID", "width": 80 },
      { "name": "user_id", "label": "用户ID", "width": 80 },
      { "name": "username", "label": "用户名" },
      { "name": "path", "label": "请求路径" },
      { "name": "method", "label": "方法", "type": "mapping", "map": { "GET": "<span style='color:#27ae60'>GET</span>", "POST": "<span style='color:#3498db'>POST</span>", "PUT": "<span style='color:#e67e22'>PUT</span>", "DELETE": "<span style='color:#e74c3c'>DELETE</span>", "*": "${method}" } },
      { "name": "ip", "label": "IP地址" },
      { "name": "created_at", "label": "访问时间", "type": "datetime", "width": 170 }
    ],
    "headerToolbar": ["reload", "filter"],
    "filter": { "title": "筛选", "body": [{ "type": "input-text", "name": "username", "label": "用户名" }, { "type": "input-text", "name": "path", "label": "请求路径" }] },
    "bulkActions": [],
    "footerToolbar": ["pagination"]
  }
}
