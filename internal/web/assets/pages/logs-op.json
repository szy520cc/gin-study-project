{
  "type": "page",
  "title": "操作日志",
  "body": {
    "type": "crud",
    "api": { "method": "get", "url": "/api/v1/logs/op" },
    "perPage": 15,
    "columns": [
      { "name": "id", "label": "ID", "width": 80 },
      { "name": "username", "label": "操作人", "width": 100 },
      { "name": "action", "label": "操作内容" },
      { "name": "target_type", "label": "操作对象" },
      { "name": "target_id", "label": "对象ID", "width": 80 },
      { "name": "ip", "label": "IP地址", "width": 130 },
      { "name": "created_at", "label": "操作时间", "type": "datetime", "width": 170 }
    ],
    "headerToolbar": ["reload", "filter"],
    "filter": { "title": "筛选", "body": [{ "type": "input-text", "name": "username", "label": "操作人" }, { "type": "input-text", "name": "action", "label": "操作内容" }] },
    "bulkActions": [],
    "footerToolbar": ["pagination"]
  }
}
