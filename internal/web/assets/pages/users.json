{
  "type": "page",
  "title": "用户管理",
  "body": {
    "type": "crud",
    "name": "usersCrud",
    "api": {
      "method": "get",
      "url": "/api/v1/users"
    },
    "perPage": 10,
    "perPageAvailable": [10, 20, 50, 100],
    "pageField": "page",
    "perPageField": "page_size",
    "columns": [
      { "name": "id", "label": "ID", "sortable": true, "width": 80 },
      { "name": "username", "label": "用户名", "sortable": true },
      { "name": "created_at", "label": "注册时间", "type": "datetime", "sortable": true, "width": 180 }
    ],
    "headerToolbar": [
      { "type": "button", "label": "新增用户", "level": "primary", "actionType": "link", "link": "#/pages/user-add.json" },
      "reload"
    ],
    "footerToolbar": [
      "switch-per-page",
      "pagination"
    ]
  }
}
