{
  "type": "page",
  "title": "用户管理",
  "body": {
    "type": "crud",
    "name": "usersCrud",
    "api": {
      "method": "get",
      "url": "/api/v1/users"
    },
    "perPage": 10,
    "perPageAvailable": [10, 20, 50, 100],
    "pageField": "page",
    "perPageField": "page_size",
    "columns": [
      { "name": "id", "label": "ID", "sortable": true, "width": 80 },
      { "name": "username", "label": "用户名", "sortable": true },
      { "name": "email", "label": "邮箱" },
      { "name": "phone", "label": "手机号" },
      { "name": "created_at", "label": "注册时间", "type": "datetime", "sortable": true, "width": 180 }
    ],
    "filter": {
      "title": "筛选",
      "body": [
        { "type": "input-text", "name": "username", "label": "用户名（模糊）" },
        { "type": "input-text", "name": "email", "label": "邮箱（模糊）" }
      ]
    },
    "headerToolbar": [
      "filter",
      "reload",
      { "type": "button", "label": "新增用户", "level": "primary", "actionType": "link", "link": "#/pages/user-add.json" }
    ],
    "footerToolbar": [
      "switch-per-page",
      "pagination"
    ]
  }
}
