{
  "type": "page",
  "title": "基础配置",
  "body": {
    "type": "form",
    "api": "put:/api/v1/config/base",
    "mode": "horizontal",
    "body": [
      { "type": "input-text", "name": "site_name", "label": "网站名称", "required": true, "value": "Gin Study 管理后台" },
      { "type": "input-text", "name": "site_url", "label": "网站地址", "value": "http://localhost:8080" },
      { "type": "input-number", "name": "page_size", "label": "默认分页数", "value": 10 },
      { "type": "textarea", "name": "site_keywords", "label": "SEO 关键词" },
      { "type": "textarea", "name": "site_description", "label": "网站描述" }
    ],
    "actions": [{ "type": "submit", "label": "保存配置", "level": "primary" }]
  }
}
